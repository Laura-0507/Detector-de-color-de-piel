
// Reloj de 27 MHz de la placa
IO_LOC "clk" 52;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// UART hacia el modulo FT232R (YP-05)
// uart_rx  <- TXD del FT232R
// uart_tx  -> RXD del FT232R
// Verifica estos numeros con el diagrama de pines de TU placa y usa pines de 3.3 V
IO_LOC "uart_rx" 25;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "uart_tx" 26;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 DRIVE=8;

// LEDs de la placa (activos en bajo, banco de 1.8 V)
IO_LOC "led[0]" 10;
IO_LOC "led[1]" 11;
IO_LOC "led[2]" 13;
IO_LOC "led[3]" 14;
IO_LOC "led[4]" 15;
IO_LOC "led[5]" 16;
IO_PORT "led[0]" IO_TYPE=LVCMOS18 DRIVE=8;
IO_PORT "led[1]" IO_TYPE=LVCMOS18 DRIVE=8;
IO_PORT "led[2]" IO_TYPE=LVCMOS18 DRIVE=8;
IO_PORT "led[3]" IO_TYPE=LVCMOS18 DRIVE=8;
IO_PORT "led[4]" IO_TYPE=LVCMOS18 DRIVE=8;
IO_PORT "led[5]" IO_TYPE=LVCMOS18 DRIVE=8;
